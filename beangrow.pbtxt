# Safe baseline for fava-portfolio-returns.
#
# Each investment is one commodity held in one exact asset account.  XP
# dividend/JCP/Rendimento accounts are intentionally not listed here because
# they are generic accounts and cannot be assigned to a specific security
# without duplicating the income across every XP investment.

investments {
  # Banco do Brasil
  investment {
    currency: "CDB-BB"
    asset_account: "Assets:Investment:BB:CDB-BB"
    cash_accounts: "Equity:Transfers:BB:Cash"
    cash_accounts: "Assets:Bank:BB:Cash"
  }

  # Interactive Brokers
  investment {
    currency: "AVGS"
    asset_account: "Assets:Investment:IBKR:AVGS"
    cash_accounts: "Assets:Bank:IBKR:Cash:USD"
  }
  investment {
    currency: "EIMI"
    asset_account: "Assets:Investment:IBKR:EIMI"
    cash_accounts: "Assets:Bank:IBKR:Cash:USD"
  }
  investment {
    currency: "IWDA"
