    currency: "IWVL"
    asset_account: "Assets:Investment:IBKR:IWVL"
    cash_accounts: "Assets:Bank:IBKR:Cash:USD"
  }
  investment {
    currency: "VUSD"
    asset_account: "Assets:Investment:IBKR:VUSD"
    dividend_accounts: "Income:Investment:IBKR:VUSD:Dividend"
    cash_accounts: "Assets:Bank:IBKR:Cash:USD"
  }
  investment {
    currency: "VWRA"
    asset_account: "Assets:Investment:IBKR:VWRA"
    cash_accounts: "Assets:Bank:IBKR:Cash:USD"
  }

  # Inter
  investment {
    currency: "CDB-CDB3257NOQI-BANCO-BMG-S-A"
    asset_account: "Assets:Investment:Inter:CDB-CDB3257NOQI-BANCO-BMG-S-A"
    cash_accounts: "Equity:Transfers:Inter:Cash"
  }
  investment {
    currency: "CRI-22B0004808-RIZA-SECURITIZADORA-S-A"
    asset_account: "Assets:Investment:Inter:CRI-22B0004808-RIZA-SECURITIZADORA-S-A"
    match_accounts: "Income:Investment:Inter:Interest"
    cash_accounts: "Equity:Transfers:Inter:Cash"
  }
  investment {
    currency: "TESOURO-IPCA-2050"
    asset_account: "Assets:Investment:Inter:TESOURO-IPCA-2050"
    cash_accounts: "Equity:Transfers:Inter:Cash"
  }

